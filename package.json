{
  "name": "heat-padel-club",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build && node scripts/build-worker.mjs",
    "preview": "wrangler dev --port 8787",
    "db:generate": "drizzle-kit generate --config drizzle.config.mjs",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "better-auth": "^1.7.10",
    "drizzle-orm": "^0.45.2",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    }
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.25.12",
    "miniflare": "^5.20261012.1-beta",
    "prettier": "^3.6.2",
    "sharp": "^0.35.5",
    "wrangler": "^4.151.1"
  }
}
