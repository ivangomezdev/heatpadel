{
  "name": "heat-padel-club",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "node scripts/build.mjs",
    "preview": "wrangler dev --port 8787",
    "db:generate": "drizzle-kit generate --config drizzle.config.mjs",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "test": "node --test tests/*.test.mjs",
    "test:postgres": "node scripts/test-postgres.mjs",
    "dev:node": "node scripts/dev-node.mjs",
    "start": "next start",
    "db:migrate:postgres": "node --env-file=.env.local scripts/migrate-postgres.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "better-auth": "^1.7.10",
    "drizzle-orm": "^0.45.2",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    }
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.25.12",
    "miniflare": "^5.20261012.1-beta",
    "prettier": "^3.6.2",
    "sharp": "^0.35.5",
    "wrangler": "^4.151.1"
  }
}
